-// UnregisterFD removes a file descriptor from monitoring.
-//
-// On targets where public readiness FD polling is unsupported, such as Windows
-// and wasm/js, UnregisterFD returns [ErrFDUnsupported].
-//
-// When the last user FD is unregistered, the loop switches to channel-based
-// wakeup mode which has lower latency (~50ns).
-//
-// Prefer unregistering an FD before closing it. On Darwin and Linux, closing it
-// first is also supported: UnregisterFD deletes and closes the poller's owned
-// duplicate, then retires local ownership and liveness. UnregisterFD prevents a
-// not-yet-started callback for that registration from starting and waits for a
-// callback whose start was already claimed; it does not wait for that callback
-// to finish. A returned [FDUnregisterError] reports whether ownership was
-// released despite a native mutation or descriptor-cleanup failure.
-func (l *Loop) UnregisterFD(fd int) error {
-	if !fdPollingSupported {
-		return ErrFDUnsupported
-	}
-	if fd < 0 || fd >= maxFDLimit {
-		return ErrFDOutOfRange
-	}
-
-	l.fdMu.Lock()
-	defer l.fdMu.Unlock()
-	l.livenessMu.Lock()
-	if err := l.rejectFDMutationLocked(true); err != nil {
-		l.livenessMu.Unlock()
-		return err
-	}
-	if !l.pollerReady.Load() {
-		l.livenessMu.Unlock()
-		return ErrFDNotRegistered
-	}
-	if !l.poller.userFDRegistered(fd) {
-		l.livenessMu.Unlock()
-		return ErrFDNotRegistered
-	}
-	if l.testHooks != nil && l.testHooks.BeforeFDUnregister != nil {
-		l.testHooks.BeforeFDUnregister()
-	}
-	// Darwin joins native result conversion before recycling a retired Udata
-	// slot. Release a sleeping native wait first; Linux deduplicates the same
-	// harmless physical wake.
-	l.doWakeup()
