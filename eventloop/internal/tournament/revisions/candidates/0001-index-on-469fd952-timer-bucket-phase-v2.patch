-		// to pollFastMode immediately, rather than waiting for the next
-		// submitToQueue call or PollIO timeout to trigger the mode change.
-		if remaining == 0 {
-			l.doWakeup()
-		}
-		return err
-	}
-	l.livenessMu.Unlock()
-	return err
-}
