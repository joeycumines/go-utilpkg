-			return true
-		}
-		if l.ownerInternalCount.Load() > 0 || l.ownerExternalCount.Load() > 0 || l.activePhaseJobCount.Load() > 0 {
-			return true
-		}
-		if l.ownerPhaseWorkAlive() {
-			return true
-		}
-
-		// Slow path: check queue lengths under mutex.
