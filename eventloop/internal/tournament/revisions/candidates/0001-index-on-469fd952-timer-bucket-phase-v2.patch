-			<-l.loopDone
-
-			l.closeFDs()
-			l.terminateCleanup()
-			l.closeTerminalDone()
-
-			return l.fdResourceCloseError()
-		}
-		l.callbackGateMu.Unlock()
-		l.terminalDrainMu.Unlock()
-		l.livenessMu.Unlock()
-	}
-}
