-func (l *Loop) rollbackFDRegistration(fd int) error {
-	if l.testHooks != nil && l.testHooks.RegisterFDRollback != nil {
-		return l.testHooks.RegisterFDRollback(fd)
-	}
-	l.doWakeup()
-	return l.poller.UnregisterFD(fd)
-}
