-// FDRegistrationRollbackError reports a partial platform registration or a
-// failed rollback after [Loop.RegisterFD] later discovered a lifecycle or mode
-// rejection. Registered describes final ownership after every attempted cleanup.
-// When it is true, callers must treat the FD as still owned by the loop until a successful
-// [Loop.UnregisterFD] or loop termination cleanup. The error unwraps both Cause
-// and Rollback so [errors.Is] and [errors.As] continue to match the original
-// lifecycle/mode error and the rollback failure.
-type FDRegistrationRollbackError struct {
-	Cause      error
-	Rollback   error
-	Registered bool
-}
-
-func (e *FDRegistrationRollbackError) Error() string {
-	if e == nil {
-		return "eventloop: fd registration rollback failed"
-	}
-	return fmt.Sprintf("eventloop: fd registration rollback failed; cause=%v rollback=%v registered=%v", e.Cause, e.Rollback, e.Registered)
-}
-
-func (e *FDRegistrationRollbackError) Unwrap() []error {
-	if e == nil {
-		return nil
-	}
-	errs := make([]error, 0, 2)
-	if e.Cause != nil {
-		errs = append(errs, e.Cause)
-	}
-	if e.Rollback != nil {
-		errs = append(errs, e.Rollback)
-	}
-	return errs
-}
