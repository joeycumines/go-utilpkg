+func TestChainedPromiseReactionObservesPublishedFulfillment(t *testing.T) {
+	loop, err := New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	registerLoopCleanupT(t, loop)
+	js, err := NewJS(loop)
+	if err != nil {
+		t.Fatal(err)
+	}
+	promise, resolve, _ := js.NewChainedPromise()
+	observed := make(chan struct {
+		state PromiseState
+		value any
+	}, 1)
+	promise.Then(func(value any) any {
+		observed <- struct {
+			state PromiseState
+			value any
+		}{state: promise.State(), value: promise.Value()}
+		return value
+	}, nil)
+
+	handlerQueued := make(chan struct{})
+	releaseResolver := make(chan struct{})
+	release := releaseSignalT(t, releaseResolver)
+	var once sync.Once
+	loop.testHooks = &loopTestHooks{
+		AfterPromiseHandlerScheduled: func() {
+			once.Do(func() {
+				close(handlerQueued)
+				<-releaseResolver
+			})
+		},
+	}
+	runDone := make(chan error, 1)
+	go func() { runDone <- loop.Run(context.Background()) }()
+	resolveDone := make(chan struct{})
+	go func() {
+		resolve("published")
+		close(resolveDone)
+	}()
+
+	select {
+	case <-handlerQueued:
+	case <-time.After(5 * time.Second):
+		t.Fatal("resolver did not queue the reaction")
+	}
+	select {
+	case got := <-observed:
+		if got.state != Fulfilled || got.value != "published" {
+			t.Fatalf("reaction observed state=%v value=%#v", got.state, got.value)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("reaction did not execute while resolver was paused")
+	}
+	release()
+	select {
+	case <-resolveDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("resolver did not return")
+	}
+	if err := loop.Shutdown(context.Background()); err != nil {
+		t.Fatalf("Shutdown: %v", err)
+	}
+	if err := <-runDone; err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+}
