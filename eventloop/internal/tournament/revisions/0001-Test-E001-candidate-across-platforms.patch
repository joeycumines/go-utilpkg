+func TestAbortSignalCleanupPanicStillDeliversHandlers(t *testing.T) {
+	signal := newAbortSignal()
+	marker := errors.New("cleanup panic")
+	var calls atomic.Int32
+	signal.OnAbort(func(any) { calls.Add(1) })
+	signal.OnAbort(func(any) { calls.Add(1) })
