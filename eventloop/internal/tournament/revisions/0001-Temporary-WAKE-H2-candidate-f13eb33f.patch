+	select {
+	case <-closeReachedResource:
+	case <-time.After(5 * time.Second):
+		t.Fatal("Close did not reach wake-resource teardown")
+	}
+	select {
+	case err := <-closeDone:
+		releaseOnce.Do(func() { close(releaseWake) })
+		<-wakeDone
+		t.Fatalf("Close released wake resources while an admitted wake was in flight: %v", err)
+	case <-time.After(100 * time.Millisecond):
+	}
+
+	releaseOnce.Do(func() { close(releaseWake) })
+	select {
+	case err := <-wakeDone:
+		if err != nil {
+			t.Fatalf("physical wake failed: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("physical wake did not finish")
+	}
+	select {
+	case err := <-closeDone:
+		if err != nil {
+			t.Fatalf("Close failed: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Close did not finish after the admitted wake")
+	}
+}
