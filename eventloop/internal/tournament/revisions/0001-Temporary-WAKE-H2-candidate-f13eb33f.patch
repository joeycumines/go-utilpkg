+func TestPhysicalWakeReleasesNativePollIO(t *testing.T) {
+	var pipeFDs [2]int
+	if err := unix.Pipe(pipeFDs[:]); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = unix.Close(pipeFDs[0])
+		_ = unix.Close(pipeFDs[1])
