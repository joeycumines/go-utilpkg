  "files": [
    "index.d.ts",
    "globals.d.ts",
    "url.d.ts",
    "buffer.d.ts",
    "buffer.buffer.d.ts"
  ],
  "scripts": {
    "test": "tsc --noEmit"
  },
  "keywords": [
    "goja",
    "goja_nodejs",
    "typescript",
    "types",
    "nodejs",
    "buffer",
    "url"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeycumines/goja_nodejs.git",
    "directory": "types"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "typescript": "next"
  }
}
