{
  "name": "@joeycumines/goja_nodejs",
  "version": "0.0.0",
  "description": "TypeScript type definitions for the goja_nodejs Node.js compatibility layer (goja fork). Covers the global GojaNodeJS namespace, the url/node:url modules (URL, URLSearchParams), and the buffer/node:buffer modules (Buffer).",
